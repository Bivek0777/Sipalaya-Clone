ESEWA_MERCHANT_ID=your_esewa_merchant_id
ESEWA_APP_ID=your_esewa_app_id
ESEWA_SECRET_KEY=your_esewa_secret
KHALTI_PUBLIC_KEY=your_khalti_public_key
KHALTI_SECRET_KEY=your_khalti_secret_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# Email Config (Nodemailer)
# Use a real SMTP account. For Gmail, set EMAIL_USER to your Gmail address
# and EMAIL_PASS to an App Password from Google account security settings.
# Optional: set EMAIL_SERVICE for providers like gmail, sendgrid, or outlook.
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
